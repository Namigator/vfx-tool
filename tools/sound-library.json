{
  "note": "Curated CC0 sounds for the built-in sound library. tools/build-sounds.mjs converts each `src` (under work/sounds-raw, downloaded from OpenGameArt by the owner-approved CC0 search, 2026-10-30) to assets/sounds/<id>.wav (48 kHz mono PCM16, silence trimmed, peak -1 dBFS) and writes assets/sounds/manifest.json with provenance. `maxSec` cuts long loops/beds.",
  "packs": {
    "100-cc0-sfx": { "url": "https://opengameart.org/content/100-cc0-sfx", "author": "rubberduck" },
    "25-cc0-bang-firework-sfx": { "url": "https://opengameart.org/content/25-cc0-bang-firework-sfx", "author": "rubberduck" },
    "40-cc0-water-splash-slime-sfx": { "url": "https://opengameart.org/content/40-cc0-water-splash-slime-sfx", "author": "rubberduck" },
    "75-cc0-breaking-falling-hit-sfx": { "url": "https://opengameart.org/content/75-cc0-breaking-falling-hit-sfx", "author": "rubberduck" },
    "80-cc0-rpg-sfx": { "url": "https://opengameart.org/content/80-cc0-rpg-sfx", "author": "rubberduck" },
    "electricity-game-sound-pack": { "url": "https://opengameart.org/content/electricity-game-sound-pack", "author": "faxcorp" },
    "electricity-sound-effects-0": { "url": "https://opengameart.org/content/electricity-sound-effects-0", "author": "BMacZero" },
    "fire-crackling": { "url": "https://opengameart.org/content/fire-crackling", "author": "AntumDeluge" },
    "fireplace-sound-loop": { "url": "https://opengameart.org/content/fireplace-sound-loop", "author": "PagDev" },
    "freeze-spell-0": { "url": "https://opengameart.org/content/freeze-spell-0", "author": "artisticdude" },
    "ice-spells": { "url": "https://opengameart.org/content/ice-spells", "author": "bart" },
    "magic-spell-sfx": { "url": "https://opengameart.org/content/magic-spell-sfx", "author": "JaggedStone" },
    "rpg-sound-pack": { "url": "https://opengameart.org/content/rpg-sound-pack", "author": "artisticdude" },
    "spell-sounds": { "url": "https://opengameart.org/content/spell-sounds", "author": "HaelDB" },
    "swishes-sound-pack": { "url": "https://opengameart.org/content/swishes-sound-pack", "author": "artisticdude" },
    "wind": { "url": "https://opengameart.org/content/wind", "author": "IgnasD" }
  },
  "pick": [
    { "prefix": "fire-cast", "pack": "80-cc0-rpg-sfx", "match": "spell_fire_0[1-7]", "tags": ["fire", "cast", "whoosh"], "usage": "fire spell cast / burst" },
    { "prefix": "fire-crackle", "pack": "fire-crackling", "match": "fire-1", "tags": ["fire", "loop", "bed"], "usage": "crackling flame bed under a burn", "maxSec": 3 },
    { "prefix": "fire-roar", "pack": "fireplace-sound-loop", "match": "fire", "tags": ["fire", "loop", "bed"], "usage": "steady fire roar bed", "maxSec": 4 },
    { "prefix": "boom", "pack": "25-cc0-bang-firework-sfx", "match": "bang_0[1-9]|bang_10", "tags": ["impact", "explosion"], "usage": "explosion / heavy impact" },
    { "prefix": "cannon", "pack": "25-cc0-bang-firework-sfx", "match": "cannon_0[1-5]", "tags": ["impact", "launch"], "usage": "launch thump / cannon" },
    { "prefix": "firework", "pack": "25-cc0-bang-firework-sfx", "match": "fw_0[1-6]", "tags": ["impact", "sparkle", "burst"], "usage": "burst with crackling sparkle tail" },
    { "prefix": "splash", "pack": "40-cc0-water-splash-slime-sfx", "match": "splash_(0[1-9]|1[0-5])", "tags": ["water", "impact"], "usage": "water splash" },
    { "prefix": "water-flow", "pack": "40-cc0-water-splash-slime-sfx", "match": "loop_water_0[1-3]", "tags": ["water", "loop", "bed"], "usage": "flowing water bed", "maxSec": 3 },
    { "prefix": "bubbles", "pack": "40-cc0-water-splash-slime-sfx", "match": "loop_bubbles|bubble_0[1-3]", "tags": ["water", "poison", "bubble"], "usage": "bubbling", "maxSec": 3 },
    { "prefix": "slime", "pack": "40-cc0-water-splash-slime-sfx", "match": "slime_(0[1-9]|1[0-6])", "tags": ["poison", "slime", "impact"], "usage": "wet slime / acid splat" },
    { "prefix": "rock-break", "pack": "75-cc0-breaking-falling-hit-sfx", "match": "rock_breaking_0[1-3]", "tags": ["earth", "impact", "break"], "usage": "rock cracking / breaking" },
    { "prefix": "rock-fall", "pack": "75-cc0-breaking-falling-hit-sfx", "match": "rock_falling_0[1-6]", "tags": ["earth", "debris"], "usage": "rocks falling / debris" },
    { "prefix": "glass-break", "pack": "75-cc0-breaking-falling-hit-sfx", "match": "glass_breaking_0[1-6]", "tags": ["ice", "shatter", "impact"], "usage": "shatter (ice crystals)" },
    { "prefix": "hit", "pack": "75-cc0-breaking-falling-hit-sfx", "match": "bfh1_hit_(0[1-9]|1[0-3])", "tags": ["impact"], "usage": "generic hit" },
    { "prefix": "freeze", "pack": "freeze-spell-0", "match": "freeze", "tags": ["ice", "cast"], "usage": "freeze spell" },
    { "prefix": "ice", "pack": "ice-spells", "match": "coldsnap|ice", "tags": ["ice", "cast", "impact"], "usage": "ice snap / crystal" },
    { "prefix": "spark", "pack": "electricity-sound-effects-0", "match": "spark|continuousspark", "tags": ["lightning", "spark"], "usage": "electric spark" },
    { "prefix": "zap", "pack": "electricity-game-sound-pack", "match": "hit|groundhit|teleport_1|death_1", "tags": ["lightning", "impact", "zap"], "usage": "electric zap / strike" },
    { "prefix": "electric-loop", "pack": "electricity-game-sound-pack", "match": "crackleelectricityloop|snaploop", "tags": ["lightning", "loop", "bed"], "usage": "crackling electricity bed", "maxSec": 3 },
    { "prefix": "charge", "pack": "electricity-game-sound-pack", "match": "^charge$|powerup|chargestart", "tags": ["charge", "energy", "rise"], "usage": "rising charge-up", "maxSec": 3 },
    { "prefix": "power-down", "pack": "electricity-game-sound-pack", "match": "powerdown", "tags": ["energy", "tail"], "usage": "falling power-down tail" },
    { "prefix": "magic", "pack": "magic-spell-sfx", "match": "magical", "tags": ["arcane", "magic", "cast"], "usage": "magic cast / shimmer" },
    { "prefix": "spell", "pack": "80-cc0-rpg-sfx", "match": "spell_0[12]", "tags": ["arcane", "magic", "cast"], "usage": "short spell cast" },
    { "prefix": "teleport", "pack": "spell-sounds", "match": "teleport", "tags": ["arcane", "magic", "whoosh"], "usage": "teleport / portal swirl", "maxSec": 3, "license": "CC0 (dual-licensed CC0 / OGA-BY; used under CC0)" },
    { "prefix": "heal", "pack": "rpg-sound-pack", "match": "^spell$|magic1", "tags": ["light", "holy", "magic"], "usage": "healing / holy shimmer", "maxSec": 3 },
    { "prefix": "bell", "pack": "100-cc0-sfx", "match": "bell_0[1-3]|gong_0[12]", "tags": ["light", "holy", "ring"], "usage": "bell / gong ring (holy light)" },
    { "prefix": "shade", "pack": "rpg-sound-pack", "match": "shade([1-9]|1[0-5])$", "tags": ["shadow", "dark", "voice"], "usage": "dark breathy shade / void moan" },
    { "prefix": "wind", "pack": "wind", "match": "Wind", "tags": ["wind", "loop", "bed"], "usage": "wind gust bed", "maxSec": 3 },
    { "prefix": "swish", "pack": "swishes-sound-pack", "match": "swish-([1-9]|1[0-3])$", "tags": ["wind", "whoosh", "swing"], "usage": "fast swish / whoosh" },
    { "prefix": "blade", "pack": "80-cc0-rpg-sfx", "match": "blade_0[1-3]", "tags": ["wind", "slice", "whoosh"], "usage": "sharp blade swish (wind cut)" }
  ]
}
